{
    "name": "mestiaque/retail",
    "description": "Retail module for Laravel (by M. Estiaque Ahmed Khan)",
    "type": "library",
    "keywords": [
        "Laravel",
        "Retail",
        "Estiaque"
    ],
    "authors": [
        {
            "name": "M. Estiaque Ahmed Khan",
            "email": "info@mestiaque.com",
            "homepage": "https://mestiaque.com"
        }
    ],
    "repositories": [
        {
            "type": "path",
            "url": "../../metheme",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": "^8.1",
        "mestiaque/metheme": "*"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "ME\\Retail\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ME\\Retail\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ME\\Retail\\RetailServiceProvider"
            ]
        }
    },
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true
}
